# ──────────────────────────────────────────────────────────────────────────────
# AgentOS configuration. Every variable is prefixed AGENTOS_ and maps 1:1 onto
# agentos.utils.config.Settings. Copy to `.env` — the server loads it automatically.
# ──────────────────────────────────────────────────────────────────────────────

# ── State ────────────────────────────────────────────────────────────────────
# Structured, durable state. Supported schemes:
#   memory://                                  → in-process store (dev/tests)
#   sqlite+aiosqlite:///./agentos.db           → single-node durable (pip install agentos[sqlite])
#   postgresql+asyncpg://agentos:agentos@localhost:5432/agentos  → production (pip install agentos[postgres])
AGENTOS_DATABASE_URL=memory://

# Ephemeral agent context (scratchpads, locks, pub/sub). Optional: falls back to
# in-process structures when unset.
# AGENTOS_REDIS_URL=redis://localhost:6379/0

# ── Task queue ───────────────────────────────────────────────────────────────
# When set, goals submitted over HTTP are dispatched to Celery workers instead of
# executing in the API process. Leave unset for the built-in asyncio executor.
# AGENTOS_CELERY_BROKER_URL=redis://localhost:6379/1

# ── Autonomy & human-in-the-loop (opt-in, NOT default) ───────────────────────
# never      → full autonomy. Deliver the outcome, no gates. (default)
# risky_only → pause only before actions marked risk_level="high".
# required   → pause before every task until an approval is granted.
AGENTOS_APPROVAL_POLICY=never

# Secret used to HMAC-sign outbound webhooks so receiving agents can verify
# provenance. Generate with: openssl rand -hex 32
# AGENTOS_WEBHOOK_SECRET=change-me

# Shared-secret auth for machine callers. When set, all mutating endpoints
# require `Authorization: Bearer <key>`. There are no login pages — ever.
# AGENTOS_API_KEY=

# ── LLM backend (pluggable; all optional — AgentOS degrades gracefully) ──────
# openai | anthropic | openai-compatible | none
AGENTOS_LLM_PROVIDER=openai-compatible
# Any model identifier your provider understands, e.g. gpt-4o, claude-sonnet-4,
# ollama/qwen2.5, or a route name on your local gateway/proxy.
AGENTOS_LLM_MODEL=gpt-4o
AGENTOS_LLM_API_KEY=
# Point at any OpenAI-schema /chat/completions endpoint: OpenAI, a local gateway,
# LiteLLM proxy, Ollama (--api-openai), LM Studio…
AGENTOS_LLM_BASE_URL=http://localhost:4000/v1

# ── Server ───────────────────────────────────────────────────────────────────
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=8080
AGENTOS_LOG_LEVEL=info
# Public base URL used to build absolute links in API responses/webhooks.
AGENTOS_PUBLIC_BASE_URL=http://localhost:8080

# ── Observability ────────────────────────────────────────────────────────────
# OTLP exporter endpoint (pip install agentos[otel]). Unset = traces disabled.
# AGENTOS_OTEL_ENDPOINT=http://localhost:4318/v1/traces
